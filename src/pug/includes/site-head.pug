head

    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    if currentPage === 'home'
        meta(name='description', content='创鸿信提供液压、气动及工业应用密封产品与解决方案。')
        link(rel='canonical', href='https://www.chx-sz.com/')
    else
        meta(name='description', content='')
    meta(name='author', content='')

    title= pageTitle

    script.
        (function () {
            try {
                var savedLanguage = localStorage.getItem('site-language');
                if (savedLanguage === 'zh') {
                    document.documentElement.lang = 'zh-CN';
                    document.documentElement.classList.add('language-pending');
                }
            } catch (error) {}
        })();

    // Favicon
    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

    // Font Awesome icons (free version)
    script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

    // Google fonts
    link(href='https://fonts.googleapis.com/css?family=Montserrat:400,700', rel='stylesheet', type='text/css')
    link(href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700', rel='stylesheet', type='text/css')

    // Core theme CSS (includes Bootstrap)
    link(href='css/styles.css', rel='stylesheet')
